
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=agentic_ai

AI_ENCRYPTION_KEY=your_64_character_encryption_key

GOOGLE_CLIENT_ID=

# FREE API AI
NARAROUTER_API_KEY=your_api_key
NARAROUTER_MODEL=agnes-2.5-flash

# Forgot password: Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Agentic AI <noreply@your-verified-domain.com>
# Generate a random secret of at least 32 characters; keep it private.
PASSWORD_RESET_PEPPER=replace_with_a_random_secret_at_least_32_chars

# --- Cloud Workspace (Phase 6), all optional; see docs/phase6-cloud-workspace.md ---
# Where workspace files are stored (default: data/workspaces next to the server).
# CLOUD_WORKSPACE_ROOT=data/workspaces
# Running tests and builds is OFF unless this is exactly "true". It also needs the
# separate execution worker (cmd/execution-worker) and a working Docker sandbox.
# CLOUD_EXECUTION_ENABLED=false
# Worker settings: approved images, limits and the non-root user the commands run as.
# CLOUD_EXEC_IMAGE_GO=golang:1.27
# CLOUD_EXEC_IMAGE_NODE=node:22-bookworm
# CLOUD_EXEC_IMAGE_PYTHON=python:3.12-slim
# CLOUD_EXEC_MEMORY=1g
# CLOUD_EXEC_CPUS=1
# CLOUD_EXEC_PIDS_LIMIT=128
# CLOUD_EXEC_RUN_AS=65534:65534
# CLOUD_EXEC_MAX_CONCURRENT=2
# CLOUD_EXEC_MAX_PER_USER=1
# Dependency installation (npm install, pip install, go mod vendor). Off unless the
# registry-only network exists: run `bash deploy/registry-proxy/setup.sh`, then set
# the same two values for the API server and the worker.
# CLOUD_EXEC_INSTALL_NETWORK=cloudexec-install
# CLOUD_EXEC_INSTALL_PROXY=cloudexec-registry-proxy:3128
# Size limits watched while a job runs (megabytes). Defaults: 300 and 1024.
# CLOUD_EXEC_MAX_DEPENDENCY_MB=300
# CLOUD_EXEC_MAX_WORKSPACE_MB=1024

# --- Public deployment (see docs/phase7-public-readiness.md) ---
# APP_ENV=production makes the server refuse to start with unsafe settings.
# APP_ENV=production
# Browser origins allowed to call the API, comma separated. Required in production.
# Empty outside production means the local Vite dev server.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Reverse proxies whose X-Forwarded-For is believed (IPs or CIDRs). Default: none.
# TRUSTED_PROXIES=10.0.0.0/8
# disable (default, local), require, verify-ca or verify-full. Production needs a TLS mode.
# DB_SSLMODE=require
# Only for a database on the same private network that speaks no TLS:
# ALLOW_PLAINTEXT_DB=true
# AI provider URLs on this computer or a private network (a local Ollama): allowed
# in development, refused in production unless set to true.
# ALLOW_PRIVATE_PROVIDER_URLS=false
# Turning on code execution in production also needs this (see the Phase 7 document):
# ALLOW_PUBLIC_CODE_EXECUTION=true

