
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=agentic_ai

AI_ENCRYPTION_KEY=your_64_character_encryption_key

# Sign-in tokens. Required: the server will not start without them, in any mode.
# Use two different random values of at least 32 characters, for example from
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing them signs everyone out.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=

# FREE API AI
NARAROUTER_API_KEY=your_api_key
NARAROUTER_MODEL=agnes-2.5-flash

# Forgot password: Resend transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Agentic AI <noreply@your-verified-domain.com>
# Generate a random secret of at least 32 characters; keep it private.
PASSWORD_RESET_PEPPER=replace_with_a_random_secret_at_least_32_chars

# --- Cloud Workspace (Phase 6), all optional; see docs/phase6-cloud-workspace.md ---
# Where workspace files are stored (default: data/workspaces next to the server).
# CLOUD_WORKSPACE_ROOT=data/workspaces
# Running tests and builds is OFF unless this is exactly "true". It also needs the
# separate execution worker (cmd/execution-worker) and a working Docker sandbox.
# CLOUD_EXECUTION_ENABLED=false
# Worker settings: approved images, limits and the non-root user the commands run as.
# CLOUD_EXEC_IMAGE_GO=golang:1.27
# CLOUD_EXEC_IMAGE_NODE=node:22-bookworm
# CLOUD_EXEC_IMAGE_PYTHON=python:3.12-slim
# Website Builder image, built on the host: docker build -t agentic-site-node:1 deploy/site-image
# CLOUD_EXEC_IMAGE_SITE=agentic-site-node:1
# CLOUD_EXEC_MEMORY=1g
# CLOUD_EXEC_CPUS=1
# CLOUD_EXEC_PIDS_LIMIT=128
# CLOUD_EXEC_RUN_AS=65534:65534
# CLOUD_EXEC_MAX_CONCURRENT=2
# CLOUD_EXEC_MAX_PER_USER=1
# Dependency installation (npm install, pip install, go mod vendor). Off unless the
# registry-only network exists: run `bash deploy/registry-proxy/setup.sh`, then set
# the same two values for the API server and the worker.
# CLOUD_EXEC_INSTALL_NETWORK=cloudexec-install
# CLOUD_EXEC_INSTALL_PROXY=cloudexec-registry-proxy:3128
# Size limits watched while a job runs (megabytes). Defaults: 300 and 1024.
# CLOUD_EXEC_MAX_DEPENDENCY_MB=300
# CLOUD_EXEC_MAX_WORKSPACE_MB=1024

# --- Public deployment (see docs/phase7-public-readiness.md) ---
# APP_ENV=production makes the server refuse to start with unsafe settings.
# APP_ENV=production
# Browser origins allowed to call the API, comma separated. Required in production.
# Empty outside production means the local Vite dev server.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Reverse proxies whose X-Forwarded-For is believed (IPs or CIDRs). Default: none.
# TRUSTED_PROXIES=10.0.0.0/8
# disable (default, local), require, verify-ca or verify-full. Production needs a TLS mode.
# DB_SSLMODE=require
# Only for a database on the same private network that speaks no TLS:
# ALLOW_PLAINTEXT_DB=true
# AI provider URLs on this computer or a private network (a local Ollama): allowed
# in development, refused in production unless set to true.
# ALLOW_PRIVATE_PROVIDER_URLS=false
# Turning on code execution in production also needs this (see the Phase 7 document):
# ALLOW_PUBLIC_CODE_EXECUTION=true


# Email OTP (register, change email). Uses the same Resend settings as forgot password.
# OTP_PEPPER is optional: when unset, PASSWORD_RESET_PEPPER is used. At least 32 characters.
OTP_PEPPER=replace_with_a_random_secret_at_least_32_chars

# GitHub connection (OAuth App): lets users import private repositories and send changes
# back as a branch and pull request. Create the app at GitHub > Settings > Developer settings
# > OAuth Apps. Authorization callback URL must equal GITHUB_OAUTH_REDIRECT_URL.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/integrations/github/callback
# FRONTEND_URL=http://localhost:5173

# Website Builder (WEBSITE-BUILDER.md in the frontend repository). Needs
# CLOUD_EXECUTION_ENABLED=true, the execution worker, cmd/agent-worker and cmd/site-runner.
# SITE_DATA_ROOT=data/sites
# Previews: p-<site>-<signed>.<SITE_PREVIEW_DOMAIN>; published sites: <name>.<SITES_DOMAIN>.
# *.localhost needs no DNS in development. In production use wildcard DNS, and a sites
# domain separate from the app's domain before strangers can publish.
# SITE_PREVIEW_DOMAIN=preview.localhost
# SITES_DOMAIN=sites.localhost
# SITE_GATEWAY_PORT=8090
# SITE_GATEWAY_BIND=127.0.0.1
# SITE_PUBLIC_SCHEME=http
# SITE_PUBLIC_PORT=8090   # empty when a proxy serves the sites on 80/443
# Published sites only, when they are served differently from previews (for example
# over HTTPS by Cloudflare Tunnel while previews stay local). Default: the two above.
# SITES_PUBLIC_SCHEME=https
# SITES_PUBLIC_PORT=        # empty: no port in the address
# Signs preview addresses; at least 32 characters. Derived from JWT_ACCESS_SECRET when unset.
# SITE_PREVIEW_SECRET=
# BUILDER_MAX_CONCURRENT=2

# Sign-up refuses throwaway e-mail (10minutemail, temp-mail...) from a built-in list
# (services/disposable_domains.txt). Add newer services here, comma separated.
# DISPOSABLE_EMAIL_EXTRA_DOMAINS=newtempmail.example,another-temp.example

# New accounts may use only well-known mail providers (Gmail, Yahoo, Outlook, iCloud,
# Proton...; see internal/emailpolicy). Add your own domains here, comma separated,
# or set EMAIL_DOMAIN_POLICY=open to allow any address that is not a throwaway one.
# One mailbox may open at most 2 accounts a year; aliases (name+x@gmail.com, n.a.me@gmail.com) count as the same mailbox.
# EMAIL_ALLOWED_DOMAINS=perusahaan.co.id
# EMAIL_DOMAIN_POLICY=known
