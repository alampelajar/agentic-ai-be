# Copy to deploy/.env.staging and fill in. That file holds secrets: never commit it
# (it is listed in .gitignore).
#
# Generate each secret with:   openssl rand -hex 32
# AI_ENCRYPTION_KEY must be exactly 64 hex characters, so use that command for it too.

# The public host name; its DNS must point at this machine for TLS to be issued.
APP_DOMAIN=staging.example.com

DB_USER=agentic
DB_PASSWORD=change-me
DB_NAME=agentic_ai
# The bundled postgres container is plaintext on a private network, so the compose
# file defaults to disable + ALLOW_PLAINTEXT_DB=true. For a managed database use
# DB_SSLMODE=require (or verify-full) and set ALLOW_PLAINTEXT_DB=false.
DB_SSLMODE=disable
ALLOW_PLAINTEXT_DB=true

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PASSWORD_RESET_PEPPER=
AI_ENCRYPTION_KEY=

# Optional
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
