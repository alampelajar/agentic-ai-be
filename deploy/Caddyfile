# TLS is automatic for a real domain whose DNS points at this host (Let's Encrypt).
# The API is on the same origin as the web app, so the browser needs no CORS for it.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8081
	}

	handle {
		reverse_proxy web:8080
	}
}
